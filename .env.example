# Copie este archivo como .env y complete SOLO en su máquina. Nunca entregue el .env.
OPENROUTER_API_KEY=
# HF_TOKEN=            # si usa LLM_PROVIDER=huggingface

# Modelos (déjelos fijos una vez iniciadas las corridas finales)
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL_ALT=google/gemma-3-27b-it:free
EMB_MODEL=intfloat/multilingual-e5-base
EMB_MODEL_ALT=BAAI/bge-m3

# Pausa entre llamadas al LLM (segundos), útil para el límite de peticiones del plan gratuito
RAG_SLEEP_S=3
# RAG_TEST_MODE=1     # solo para pruebas sin red (resultados NO válidos para el informe)
